// Compiled with --optimizations loop-unrolling: the loops with a constant
// trip count, nested ones included, become straight code; the loop with a
// break and the one with a bound read at run time stay loops.
pipeline LoopUnrolling {
    resources {
        weights: float4
    }

    pass "Main" {
        use resources { weights }
        vertex {
            output.position = float4(0.0, 0.0, 0.0, 1.0);
        }
        fragment {
            float sum = 0.0;
            for (int i = 0; i < 4; i++) {
                sum += resources.weights[i] * float(i + 1);
            }
            for (k in 0..3) {
                for (int j = 0; j <= k; j++) { sum += input.position.x * float(k * 4 + j); }
            }
            for (int i = 0; i < 8; i++) {
                if (sum > 100.0) { break; }
                sum += sum * 0.5;
            }
            int count = int(input.position.y);
            for (int i = 0; i < count; i++) { sum += float(i); }
            output.color = float4(sum);
        }
    }
}
