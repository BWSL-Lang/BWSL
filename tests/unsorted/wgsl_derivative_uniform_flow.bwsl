// Test: derivatives in straight-line code need no WGSL diagnostic filter
// Tests: sample() and fwidth() in a fragment shader without control flow
//        keep WGSL's uniformity analysis on (see
//        wgsl_derivative_uniformity.bwsl for the branching case).

pipeline DerivativeUniformFlow {
    attributes {
        position: float3
        texcoord: float2
    }

    resources {
        albedo: texture2D
    }

    pass "Main" {
        use attributes { position, texcoord }
        use resources { albedo }

        vertex {
            output.position = float4(attributes.position, 1.0);
            output.uv = attributes.texcoord;
        }

        fragment {
            float4 color = sample(resources.albedo, input.uv);
            output.color = color * fwidth(input.uv.x);
        }
    }
}
