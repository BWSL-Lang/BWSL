// Regression for issue #160: a loop calling an inlined function got
// loop-header phis for the function's locals and return flag. Each call
// writes those before reading them, so the phis were dead, and SPIRV-Cross
// turned them into copies in the loop increment. Only `sum` and `i` are
// carried between iterations of each loop.
pipeline SsaDeadLoopPhis {
    f :: (float x) -> float {
        float a = x * 2.0;
        float b;
        if (a > 3.0) { b = a + 1.0; } else { b = a - 1.0; }
        return a * b;
    }

    g :: (float x) -> float {
        float a = x * 2.0;
        if (a < 0.5) { return a; }
        float b = a + 1.0;
        return a * b;
    }

    pass "Main" {
        vertex {
            output.position = float4(0.0, 0.0, 0.0, 1.0);
        }
        fragment {
            float sum = 0.0;
            for (int i = 0; i < 9; i++) {
                sum += f(input.position.x + float(i));
            }
            for (int j = 0; j < 9; j++) {
                sum += g(input.position.y + float(j));
            }
            output.color = float4(sum);
        }
    }
}
