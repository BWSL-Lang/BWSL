// Test: a helper function using implicit-LOD sampling and derivatives
// compiles when only a fragment stage calls it.
pipeline DerivativesInFragmentHelper {
    attributes {
        position: float3
        texcoord: float2
    }

    resources {
        tex: texture2D
    }

    shade :: (float2 uv) -> float4 {
        return sample(resources.tex, uv) * fwidth(uv.x);
    }

    pass "Main" {
        use attributes { position, texcoord }
        use resources { tex }

        vertex {
            output.position = float4(attributes.position, 1.0);
            output.uv = attributes.texcoord;
        }

        fragment {
            output.color = shade(input.uv);
        }
    }
}
