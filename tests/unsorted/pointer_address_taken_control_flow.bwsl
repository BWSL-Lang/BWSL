// An address-taken first local must not treat terminators' dummy destination as a write.
pipeline PointerAddressTakenControlFlow {
    attributes { position: float3 }
    pass "Main" {
        use attributes { position }
        vertex {
            float a = 0.25;
            float^ p = ^a;
            if (attributes.position.x > 0.0) { p^ = 0.75; }
            output.position = float4(attributes.position, 1.0);
            output.value = a;
        }
        fragment {
            float a = 0.25;
            float^ p = ^a;
            if (input.value < 0.0) { discard; }
            for (int i = 0; i < 2; i = i + 1) {
                p^ = a + input.value;
                if (a > 2.0) { break; }
            }
            switch (int(input.value)) {
                case 0: { p^ = a + 0.5; }
                case 1: { discard; }
                default: { p^ = a + 0.75; }
            }
            if (a > 4.0) { output.color = float4(a); return; }
            output.color = float4(a, p^, a, 1.0);
        }
    }
}
