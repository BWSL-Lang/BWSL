// Test: Inlined return inside counted loop
// Tests: return guard combines with counted loop header condition

pipeline InlineReturnCountLoop {
    attributes {
        position: float3
    }

    chooseCount :: (int limit) -> int {
        loop (limit) {
            return 3;
        }
        return 4;
    }

    pass "Main" {
        use attributes { position }

        vertex {
            // The limit isn't a constant, so the loop isn't evaluated at compile time.
            int v = chooseCount(int(attributes.position.y) + 5);
            output.position = float4(attributes.position, 1.0);
            output.position.x = float(v);
        }
    }
}
