// Test: a pointer parameter writes through to the caller's local.
// (Previously rejected as "Pointer-typed function parameters are not
// supported", issue #205.)
pipeline PointerFunctionParam {
    attributes {
        position: float3
    }

    bump :: (float^ target) -> void {
        target^ = target^ + 1.0;
    }

    pass "Main" {
        use attributes { position }

        vertex {
            float acc = 1.0;
            bump(^acc);
            output.position = float4(attributes.position, acc);
        }
    }
}
