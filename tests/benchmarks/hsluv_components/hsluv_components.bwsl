// HSLuv to RGB with one component from the pixel and the other two
// constant: a hue sweep, a saturation sweep and a lightness sweep, each at
// fixed values of the other two. BWSL folds what depends only on the
// constant components (with a variable saturation, the whole gamut bound
// and the hue's sine and cosine), so this measures that against GLSL ES
// whose compiler sees the same constants.
pipeline HsluvComponentsBench {
    import Color

    attributes {
        position: float2
    }

    pass "Main" {
        use attributes { position }

        vertex {
            output.position = float4(attributes.position, 0.0, 1.0);
            output.uv = attributes.position * 0.5 + 0.5;
        }

        fragment {
            float2 uv = input.uv;
            float3 hueSweep = Color::hsluvToRgb(float3(uv.x * 360.0, 100.0, 50.0));
            float3 saturationSweep = Color::hsluvToRgb(float3(180.0, uv.y * 100.0, 50.0));
            float3 lightnessSweep = Color::hsluvToRgb(float3(10.0, 100.0, 5.0 + 90.0 * uv.x));
            output.color = float4(clamp(hueSweep * 0.5 + saturationSweep * 0.3 + lightnessSweep * 0.2, 0.0, 1.0),
                                  1.0);
        }
    }
}
