// Supersampled procedural noise: per pixel, 2x2 samples of domain-warped
// fbm (five 5-octave fbm calls) plus a 3x3 Worley search. Loops in loops in
// loops; hashing is integer PCG so every backend agrees bit for bit on it.
pipeline NoiseBench {
    attributes {
        position: float2
    }

    struct Params {
        // scale, time, 1/width, 1/height
        float4 view;
        float4 colorA;
        float4 colorB;
        float4 colorC;
    };

    resources {
        params: Params
    }

    const int OCTAVES = 5;

    // 2D PCG hash (Jarzynski & Olano, "Hash Functions for GPU Rendering").
    pcg2d :: (uint2 v) -> uint2 {
        v = v * 1664525u + 1013904223u;
        v.x += v.y * 1664525u;
        v.y += v.x * 1664525u;
        v = v ^ (v >> 16u);
        v.x += v.y * 1664525u;
        v.y += v.x * 1664525u;
        v = v ^ (v >> 16u);
        return v;
    }

    // Random value in [-1, 1]^2 for an integer lattice point.
    cellRandom :: (float2 cell) -> float2 {
        uint2 h = pcg2d(uint2(int2(cell)));
        return float2(float(h.x >> 24u), float(h.y >> 24u)) / 127.5 - 1.0;
    }

    gradientNoise :: (float2 p) -> float {
        float2 i = floor(p);
        float2 f = p - i;
        float2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
        float a = dot(cellRandom(i), f);
        float b = dot(cellRandom(i + float2(1.0, 0.0)), f - float2(1.0, 0.0));
        float c = dot(cellRandom(i + float2(0.0, 1.0)), f - float2(0.0, 1.0));
        float d = dot(cellRandom(i + float2(1.0, 1.0)), f - float2(1.0, 1.0));
        return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
    }

    fbm :: (float2 p) -> float {
        float sum = 0.0;
        float amplitude = 0.5;
        for (int octave = 0; octave < OCTAVES; octave++) {
            sum += amplitude * gradientNoise(p);
            p = float2(0.8 * p.x - 0.6 * p.y, 0.6 * p.x + 0.8 * p.y) * 2.02;
            amplitude *= 0.5;
        }
        return sum;
    }

    // Distance to the nearest feature point, one point per cell.
    worley :: (float2 p) -> float {
        float2 i = floor(p);
        float2 f = p - i;
        float nearest = 8.0;
        for (int y = -1; y <= 1; y++) {
            for (int x = -1; x <= 1; x++) {
                float2 offset = float2(float(x), float(y));
                float2 r = offset + cellRandom(i + offset) * 0.5 + 0.5 - f;
                nearest = min(nearest, dot(r, r));
            }
        }
        return sqrt(nearest);
    }

    pass "Main" {
        use attributes { position }
        use resources { params }

        vertex {
            output.position = float4(attributes.position, 0.0, 1.0);
            output.uv = attributes.position * 0.5 + 0.5;
        }

        fragment {
            Params p = resources.params;
            float scale = p.view.x;
            float time = p.view.y;
            float3 color = float3(0.0);
            for (int s = 0; s < 4; s++) {
                float2 jitter = (float2(float(s & 1), float(s >> 1)) - 0.5) * 0.5 * p.view.zw;
                float2 pos = (input.uv + jitter) * scale;

                float2 q = float2(fbm(pos), fbm(pos + float2(5.2, 1.3)));
                float2 r = float2(fbm(pos + 4.0 * q + float2(1.7, 9.2) + 0.15 * time),
                                  fbm(pos + 4.0 * q + float2(8.3, 2.8) + 0.126 * time));
                float n = fbm(pos + 4.0 * r);
                float cells = worley(pos * 3.0 + r);

                float3 c = lerp(p.colorA.rgb, p.colorB.rgb, clamp(n * n * 4.0, 0.0, 1.0));
                c = lerp(c, p.colorC.rgb, clamp(length(q), 0.0, 1.0));
                c *= 0.6 + 0.4 * smoothstep(0.0, 0.8, cells);
                color += c;
            }
            output.color = float4(color * 0.25, 1.0);
        }
    }
}
