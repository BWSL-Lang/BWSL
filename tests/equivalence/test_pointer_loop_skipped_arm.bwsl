// An `if` arm that points the pointer at a vector component and then skips
// doesn't reach the code after the `if`: the write there always goes to `a`,
// which the top of each iteration points the pointer back at.
pipeline EquivPointerLoopSkippedArm {
    resources { output: buffer<float> }
    pass "Compute" {
        use resources { output }
        compute "Main" [1, 1, 1] {
            float a = 1.0;
            float3 v = float3(1.0, 2.0, 3.0);
            float^ p = ^a;
            for (int i = 0; i < 3; i++) {
                p = ^a;
                if (i == 1) {
                    p = ^v.x;
                    skip;
                }
                p^ = p^ + 1.0;
            }
            resources.output[0] = a;
        }
    }
}
