// Independent CPU expectations are recorded in the adjacent JSON specification.
pipeline Semantics_value_struct_field_struct_array {
 resources { output: buffer<int> }
 struct Item {int x;}; struct Box {Item[2] values;}; f :: (Item[2] a) -> int {a[0].x+=7;return a[0].x;}
 pass "Compute" { use resources { output } compute "Main" [64,1,1] {
 uint idx=input.global_id.x; int n=int(idx);
 Box a; a.values[0].x=n;a.values[1].x=4; int r=f(a.values); resources.output[idx]=a.values[0].x*100+r;
 } }
}
