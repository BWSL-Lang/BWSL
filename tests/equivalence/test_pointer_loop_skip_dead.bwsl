// An assignment after `skip` or `break` in the same arm never runs, so the
// copy it would point at doesn't reach the next iteration's write, or the
// write after the loop. Every write here goes to `a`.
pipeline EquivPointerLoopSkipDead {
    resources { output: buffer<float> }
    pass "Compute" {
        use resources { output }
        compute "Main" [1, 1, 1] {
            float a = 1.0;
            float3 v = float3(1.0, 2.0, 3.0);
            float^ p = ^a;
            for (int i = 0; i < 3; i++) {
                p^ = p^ + 1.0;
                if (i > 0) {
                    p = ^a;
                    skip;
                    p = ^v.x;
                }
            }
            for (int j = 0; j < 3; j++) {
                p^ = p^ + 10.0;
                if (j == 1) {
                    p = ^a;
                    break;
                    p = ^v.y;
                }
            }
            p^ = p^ + 100.0;
            resources.output[0] = a;
        }
    }
}
