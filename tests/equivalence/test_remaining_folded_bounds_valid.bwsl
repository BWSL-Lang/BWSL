// Independent expected values are in the adjacent JSON.
pipeline Remaining {
 resources { output: buffer<int> }
 pass "Compute" { use resources { output }
 compute "Main" [64,1,1] { uint idx=input.global_id.x; int[2] a; a[1-1]=4; a[4%(-3)]=7; int total=0; for(int i=0;i<2;i++){ total+=a[i+0]; } resources.output[idx]=total+a[uint(0xffffffffu+2u)]+int(idx); }
 }
}
