// A pointer reassigned at the top of a loop body before a write through it.
// Its target from the previous iteration (or before the loop) points to a
// copy, but every write goes to `a`; this was rejected as a lost write.
pipeline EquivPointerLoopReassign {
    resources { output: buffer<float> }
    pass "Compute" {
        use resources { output }
        compute "Main" [1, 1, 1] {
            float a = 1.0;
            float3 v = float3(1.0, 2.0, 3.0);
            float^ p = ^v.x;
            for (int i = 0; i < 3; i++) {
                p = ^a;
                p^ = p^ + 2.0;
                p = ^v.y;
            }
            resources.output[0] = a;
        }
    }
}
