// Eval vectors must materialize into runtime constructors before and after assignment.
pipeline EvalVector {
    resources { output: buffer<int> }
    pass "Compute" {
        use resources { output }
        compute "Main" [16, 1, 1] {
            eval int3 v = int3(3, -7, 11);
            int3 original = v;
            eval { v = int3(-13, 17, -23); }
            int3 updated = v;
            uint i = input.global_id.x;
            uint lane = i % 3u;
            resources.output[i] = i < 8u ? original[lane] : updated[lane];
        }
    }
}
