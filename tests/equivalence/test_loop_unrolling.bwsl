// Loop unrolling (loop-unrolling): loops with a constant trip count become
// copies of their body, and loops that can't be unrolled stay loops with
// the same results. Each invocation runs one case.
pipeline EquivLoopUnrolling {

    resources {
        output: buffer<int>
    }

    // A loop over a parameter, unrolled where an inlined call passes a
    // constant, after an early return that may already have run.
    sumTo :: (int count, int seed) -> int {
        if (seed < 0) {
            return -1;
        }
        int total = seed;
        for (int i = 0; i < count; i++) { total += i * 3; }
        return total;
    }

    // A return inside the loop: stays a loop.
    firstAbove :: (int limit) -> int {
        for (int i = 0; i < 6; i++) {
            if (i * i > limit) { return i; }
        }
        return 100;
    }

    pass "Compute" {
        use resources { output }
        compute "Main" [16, 1, 1] {
            uint idx = input.global_id.x;
            int x = int(idx);
            int result = 0;

            if (idx == 0u) {
                // Constant bounds, the iterator indexes a local array.
                int[4] table = { 3, 5, 7, 11 };
                for (int i = 0; i < 4; i++) { result += table[i] * (i + x); }
            } else if (idx == 1u) {
                // Nested loops, both unrolled; the inner bound is the outer iterator.
                for (int i = 0; i < 3; i++) {
                    for (int j = 0; j <= i; j++) { result = result * 3 + i * 10 + j; }
                }
            } else if (idx == 2u) {
                // break and skip: stay a loop.
                for (int i = 0; i < 10; i++) {
                    if (i == 2) { skip; }
                    if (i == 7) { break; }
                    result += i * x;
                }
            } else if (idx == 3u) {
                // The body writes the iterator: stays a loop.
                for (int i = 0; i < 8; i++) {
                    if (x > 1) { i += 1; }
                    result = result * 2 + i;
                }
            } else if (idx == 4u) {
                // Descending, inclusive and stepped ranges.
                for (k in 9..0 by -3) { result = result * 10 + k; }
                for (k in 1..=4) { result = result * 2 + k; }
                for (k in 0..10 by 4) { result += k * x; }
            } else if (idx == 5u) {
                // Unsigned iterators, ending in wraparound.
                uint acc = 0u;
                for (uint u = 0u; u < 4u; u += 1u) { acc = acc * 5u + u; }
                for (u in 4294967293u..=4294967295u) { acc += u; }
                result = int(acc);
            } else if (idx == 6u) {
                // A bound held in a variable, and one the body changes.
                int n = 5;
                for (int i = 0; i < n; i++) { result += i * i; }
                int m = 6;
                for (int i = 0; i < m; i++) { m -= 1; result += i * 100; }
            } else if (idx == 7u) {
                // A bound read at run time: stays a loop.
                for (int i = 0; i < x; i++) { result += i + 1; }
            } else if (idx == 8u) {
                // Inlined calls: one constant count, one run-time count.
                result = sumTo(4, x) * 1000 + sumTo(x - 5, 2);
            } else if (idx == 9u) {
                // More iterations than unrolling takes: stays a loop.
                for (int i = 0; i < 40; i++) { result += i ^ x; }
            } else if (idx == 10u) {
                // A return inside the loop of an inlined call.
                result = firstAbove(x) * 10 + firstAbove(2);
            } else if (idx == 11u) {
                // Body-local declarations, a shadowed iterator and branches.
                int i = 1000;
                for (int i = 0; i < 4; i++) {
                    int twice = i * 2;
                    if ((i & 1) == 0) { result += twice; } else { result -= twice * x; }
                    result += i > 1 ? 7 : 1;
                }
                result += i;
            } else if (idx == 12u) {
                // A condition with && and a compound increment.
                for (int i = 1; i < 50 && i != 0; i *= 3) { result = result * 4 + i; }
            } else if (idx == 13u) {
                // A vector indexed by the iterator, and a float accumulator.
                float4 v = float4(1.5, 2.5, 3.5, 4.5);
                float f = 0.0;
                for (int i = 0; i < 4; i++) { f += v[i] * float(i + 1); }
                result = int(f * 2.0);
            } else if (idx == 14u) {
                // A loop that runs once, and one that never runs.
                for (int i = 0; i < 1; i++) { result += 42; }
                for (int i = 5; i < 5; i++) { result += 1000; }
            } else {
                // A value the body assigns, read after the loop.
                int last = 0;
                for (int i = 0; i < 5; i++) { last = i * x; result += last; }
                result = result * 100 + last;
            }
            resources.output[idx] = result;
        }
    }
}
