// Achromatic HSLuv/HPLuv boundary cases from the official revision-4
// snapshot. These guard against zero-lightness and zero-chroma NaNs.
// Source: https://github.com/hsluv/hsluv-python/blob/master/tests/snapshot-rev4.json
pipeline EquivColorConversionBoundaries {
    import Color

    resources {
        output: buffer<float>
    }

    pass "Compute" {
        use resources { output }

        compute "Main" [1, 1, 1] {
            float3[7] values;
            values[0] = Color::rgbToHsluv(float3(0.0));
            values[1] = Color::rgbToHsluv(float3(1.0));
            values[2] = Color::rgbToHsluv(float3(0.4666666666666667));
            values[3] = Color::hsluvToRgb(float3(0.0, 0.0, 0.0));
            values[4] = Color::hsluvToRgb(float3(0.0, 0.0, 100.0));
            values[5] = Color::rgbToHpluv(float3(0.0));
            values[6] = Color::hpluvToRgb(float3(0.0, 0.0, 0.0));

            foreach (i in 0..7) {
                int outputIndex = i * 3;
                resources.output[outputIndex] = values[i].x;
                resources.output[outputIndex + 1] = values[i].y;
                resources.output[outputIndex + 2] = values[i].z;
            }
        }
    }
}
