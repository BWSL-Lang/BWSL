// Eval vectors must materialize into runtime constructors before and after assignment.
pipeline EvalVector {
    resources { output: buffer<uint> }
    pass "Compute" {
        use resources { output }
        compute "Main" [16, 1, 1] {
            eval uint3 v = uint3(4294967295u, 2147483648u, 17u);
            uint3 original = v;
            eval { v = uint3(2147483649u, 4294967294u, 41u); }
            uint3 updated = v;
            uint i = input.global_id.x;
            uint lane = i % 3u;
            resources.output[i] = i < 8u ? original[lane] : updated[lane];
        }
    }
}
