// Independent CPU expectations are recorded in the adjacent JSON specification.
pipeline Regression_pointer_array_rebind {
    resources { output: buffer<int> }

    pass "Compute" {
        use resources { output }
        compute "Main" [64, 1, 1] {
            uint idx = input.global_id.x;
            int n = int(idx);
            int[4] a; a[0]=10;a[1]=20;a[2]=30;a[3]=40; int j=n%4; int^ p=^a[j]; if(n%2==1) p=^a[(j+1)%4]; j=0; p^ += n; resources.output[idx]=a[0]*1000+a[1]*100+a[2]*10+a[3];
        }
    }
}
