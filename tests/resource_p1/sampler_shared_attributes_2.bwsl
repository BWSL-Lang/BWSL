// Shared explicit samplers must use the same binding names in both GLES stages.
pipeline SharedSamplerAttributes {
    attributes { position: float2 color: float4 }
    resources { sceneTex: texture2D bloomTex: texture2D samp: sampler scale: float }
    pass "Main" {
        use attributes { position, color }
        use resources { sceneTex, bloomTex, samp, scale }
        vertex {
            output.position = float4(attributes.position, 0.0, 1.0);
            output.uv = attributes.position * 0.5 + 0.5;
            output.col = attributes.color * sample_lod(resources.sceneTex, resources.samp, float2(0.3), 0.0);
        }
        fragment {
            output.color = (sample(resources.sceneTex, resources.samp, input.uv)
                          + sample(resources.bloomTex, resources.samp, input.uv)
                          + sample(resources.bloomTex, input.uv)) * input.col * resources.scale;
        }
    }
}
