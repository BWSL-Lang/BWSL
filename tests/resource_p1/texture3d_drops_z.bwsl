// texture3D silently becomes a 2D texture; .z of the sample coordinate is dropped.
pipeline Volume {
    resources { volume: texture3D }
    pass "Main" {
        use resources { volume }
        vertex { output.position = float4(0.0, 0.0, 0.0, 1.0); }
        fragment { output.color = sample(resources.volume, float3(0.1, 0.2, 0.7)); }
    }
}
