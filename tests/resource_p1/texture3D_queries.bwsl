// Generated QA: texture3D_queries
pipeline QA {

attributes { position: float3 uv: float2 }
resources {
tex: texture3D
}
pass "Main" {
use attributes { position, uv }
use resources { tex }
vertex { output.position = float4(attributes.position, 1.0); output.uv = attributes.uv; }
fragment {
int2 s = texture_size(resources.tex, 1); int l = texture_levels(resources.tex); output.color = float4(float(s.x), float(s.y), float(l), 1.0);
}
}
}
