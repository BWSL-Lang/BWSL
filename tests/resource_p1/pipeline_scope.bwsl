pipeline First { resources { tex: texture2D nearest: sampler linear: sampler } pass "Main" { use resources { tex, nearest, linear } vertex { output.position = float4(0.0,0.0,0.0,1.0); } fragment { output.color = sample(resources.tex, resources.nearest, float2(0.3)) - sample(resources.tex, resources.linear, float2(0.3)); } } }
pipeline Last { resources { tex: texture2D nearest: sampler linear: sampler } pass "Last" { use resources { tex, nearest } vertex { output.position = float4(0.0,0.0,0.0,1.0); } fragment { output.color = sample(resources.tex, resources.nearest, float2(0.3)); } } }
