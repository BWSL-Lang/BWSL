pipeline Samplers {
 resources { tex: texture2D nearest: sampler linear: sampler }
 pass "Main" { use resources { tex, nearest, linear }
 vertex { float2[3] p; p[0] = float2(-1.0,-1.0); p[1] = float2(3.0,-1.0); p[2] = float2(-1.0,3.0); output.position = float4(p[input.vertex_id],0.0,1.0); }
 fragment { float2 uv = float2(0.31); output.color = sample_grad(resources.tex, resources.nearest, uv, float2(0.01), float2(0.01)) + sample_lod_offset(resources.tex, resources.linear, uv, 0.0, int2((8 / 2) % 3, int(uint(2) >> 1u) - 1)) + gather(resources.tex, resources.nearest, uv, 0); }
 }
}
