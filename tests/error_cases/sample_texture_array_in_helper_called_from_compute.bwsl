// Error case: a helper that samples a dynamically indexed texture array with
// implicit LOD is reported once when a compute stage calls it.
pipeline SampleTextureArrayInHelperCalledFromCompute {
    resources {
        textures: texture2D[4]
        samp: sampler
        data: buffer<float4>
    }

    fetch :: (int layer, float2 uv) -> float4 {
        return sample(resources.textures[layer], resources.samp, uv);
    }

    pass "Main" {
        use resources { textures, samp, data }

        compute "Main" [8, 8, 1] {
            uint id = input.global_id.x;
            resources.data[id] = fetch(int(id), float2(0.5, 0.5));
        }
    }
}
