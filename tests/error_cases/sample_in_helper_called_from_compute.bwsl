// Error case: a helper function that uses implicit-LOD sample() is reported
// when a compute stage calls it.
pipeline SampleInHelperCalledFromCompute {
    resources {
        tex: texture2D
        data: buffer<float4>
    }

    fetch :: (float2 uv) -> float4 {
        return sample(resources.tex, uv);
    }

    pass "Main" {
        use resources { tex, data }

        compute "Main" [8, 8, 1] {
            uint id = input.global_id.x;
            resources.data[id] = fetch(float2(0.5, 0.5));
        }
    }
}
