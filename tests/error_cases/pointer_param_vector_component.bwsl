// Error case: `^v.y` points at a copy of the component, so it can't be passed
// to a pointer parameter.
pipeline PointerParamVectorComponent {
    attributes {
        position: float3
    }

    bump :: (float^ target) -> void {
        target^ = target^ + 1.0;
    }

    pass "Main" {
        use attributes { position }

        vertex {
            float4 v = float4(attributes.position, 1.0);
            bump(^v.y);
            output.position = v;
        }
    }
}
