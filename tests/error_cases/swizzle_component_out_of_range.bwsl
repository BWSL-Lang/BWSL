// Error case: reading .z from a float2 is a source error. It used to be
// caught only by SPIR-V validation.
pipeline SwizzleComponentOutOfRange {
    attributes {
        position: float3
    }

    pass "Main" {
        use attributes { position }

        vertex {
            float2 v = float2(1.0, 2.0);
            float bad = v.z;
            output.position = float4(attributes.position, bad);
        }
    }
}
