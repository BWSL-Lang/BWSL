// min/max pick float or integer min from the first argument, so a later
// argument of the other kind used to reach SPIR-V validation.
pipeline MinMaxMixedArgumentTypes {
    pass "Main" {
        vertex { output.position = float4(0.0, 0.0, 0.0, 1.0); }
        fragment {
            float x = 1.0;
            float m = min(x, 2.0, 3);
            output.color = float4(m);
        }
    }
}
