// A dynamic element index is only lowered as a texture function's argument (#137).
pipeline TextureArrayError {
    attributes {
        position: float2
    }
    resources {
        textures: texture2D[4]
        samp: sampler
        other: texture2D
        tint: float4
    }
    shade :: (texture2D t, float2 uv) -> float4 {
        return sample(t, uv);
    }

    pass "Main" {
        use attributes { position }
        use resources { textures, samp, other, tint }
        vertex {
            output.position = float4(attributes.position, 1.0, 1.0);
            output.uv = attributes.position;
        }
        fragment {
            output.color = shade(resources.textures[int(input.uv.x)], input.uv);
        }
    }
}
