// Error case: a pointer argument must point to the parameter's pointee type;
// pointers don't convert.
pipeline PointerParamPointeeMismatch {
    attributes {
        position: float3
    }

    bump :: (float^ target) -> void {
        target^ = target^ + 1.0;
    }

    pass "Main" {
        use attributes { position }

        vertex {
            int count = 1;
            bump(^count);
            output.position = float4(attributes.position, float(count));
        }
    }
}
