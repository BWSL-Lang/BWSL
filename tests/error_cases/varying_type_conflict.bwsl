// Error case: a stage-interface value's type is inferred from its first
// assignment, so a later assignment of another type is rejected.
pipeline VaryingTypeConflict {
    attributes {
        position: float3
    }

    pass "Main" {
        use attributes { position }
        outputs { color: float4 }

        vertex {
            output.position = float4(attributes.position, 1.0);
            output.uv = float2(0.0, 1.0);
            output.uv = float3(0.0, 1.0, 0.0);
        }

        fragment {
            output.color = float4(input.uv, 0.0, 1.0);
        }
    }
}
