// Error case: an enum variant whose payload holds more than 64 scalars, the
// most the enum's storage has. It wrote past the enum struct's fields.
pipeline WrongAcceptEnumPayloadTooLarge {
    resources { output: buffer<float> }
    enum Big {
        Small(float x),
        Huge(mat4 a, mat4 b, mat4 c, mat4 d, mat4 e),
        eval value :: () -> float {
            Small(x): x
            Huge(a, b, c, d, e): a[0].x
        }
    }
    pass "Compute" {
        use resources { output }
        compute "Main" [1, 1, 1] {
            mat4 m = mat4(1.0);
            resources.output[0] = Big::Huge(m, m, m, m, m).value();
        }
    }
}
