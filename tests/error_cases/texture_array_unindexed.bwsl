// A texture array is not a texture; one of its elements is (#137).
pipeline TextureArrayError {
    attributes {
        position: float2
    }
    resources {
        textures: texture2D[4]
        samp: sampler
        other: texture2D
        tint: float4
    }
    pass "Main" {
        use attributes { position }
        use resources { textures, samp, other, tint }
        vertex {
            output.position = float4(attributes.position, 1.0, 1.0);
            output.uv = attributes.position;
        }
        fragment {
            output.color = sample(resources.textures, input.uv);
        }
    }
}
