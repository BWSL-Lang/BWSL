// Error case: module constant initializers must fold at compile time;
// normalize() isn't evaluated there.
module BadConsts {
    const float2 NORTH = float2(0.0, -1.0);
    const float2 SOUTH = normalize(NORTH);
}

pipeline ModuleConstNotConstant {
    import BadConsts

    attributes {
        position: float2
    }

    pass "Main" {
        use attributes { position }

        vertex {
            output.position = float4(attributes.position + BadConsts::SOUTH, 0.0, 1.0);
        }
    }
}
