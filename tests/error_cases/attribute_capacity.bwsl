pipeline AttributeCapacity {
    attributes {
        position: float3
        a1: float3
        a2: float3
        a3: float3
        a4: float3
        a5: float3
        a6: float3
        a7: float3
        a8: float3
        a9: float3
        a10: float3
        a11: float3
        a12: float3
        a13: float3
        a14: float3
        a15: float3
        a16: float3
    }
    pass "Main" {
        use attributes { a16 }
        vertex { output.position = float4(attributes.a16, 1.0); }
    }
}
