// Error case: a pointer rebound to a local in only one branch may still
// point at a copy after the branch, so it can't be passed.
pipeline PointerParamReboundInBranch {
    attributes {
        position: float3
    }

    bump :: (float^ target) -> void {
        target^ = target^ + 1.0;
    }

    pass "Main" {
        use attributes { position }

        vertex {
            float4 v = float4(attributes.position, 1.0);
            float w = 1.0;
            float^ p = ^v.y;
            if (attributes.position.x > 0.0) {
                p = ^w;
            }
            bump(p);
            output.position = float4(v.xyz, w);
        }
    }
}
