// Error case: a pointer that points to a copy only from a loop's second
// iteration on; the write through it is still lost.
pipeline WrongAcceptPointerStoreToCopyInLoop {
    resources { output: buffer<float> }
    pass "Compute" {
        use resources { output }
        compute "Main" [1, 1, 1] {
            float a = 1.0;
            float3 v = float3(1.0, 2.0, 3.0);
            float^ p = ^a;
            for (int i = 0; i < 2; i++) {
                p^ = 9.0;
                p = ^v.y;
            }
            resources.output[0] = a + v.y;
        }
    }
}
