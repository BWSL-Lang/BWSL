// The frexp/modf result structs are typed by their builtin id, so a
// constructor passed straight to a function keeps its `call` edge (#212).
pipeline AstJsonBuiltinResults {
    attributes { position: float3 uv: float2 }
    consume :: (BwslModfResult m) -> float {
        return m.fraction + m.whole;
    }
    pass "Main" {
        use attributes { position, uv }
        vertex { output.position = float4(attributes.position, 1.0); output.uv = attributes.uv; }
        fragment {
            float v = consume(BwslModfResult(0.25, input.uv.x));
            output.color = float4(v, frexp(input.uv.y).mantissa, 0.0, 1.0);
        }
    }
}
