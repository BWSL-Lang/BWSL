pipeline BoolReductionReassignment {
    resources {
        source: buffer<float4>
        result: buffer<uint>
    }
    pass "Compute" {
        use resources { source, result }
        compute "Main" [64, 1, 1] {
            uint index = input.global_id.x;
            bool4 flags = resources.source[index] > float4(0.0);
            flags = resources.source[index] < float4(0.0);
            uint value = select(0u, 1u, any(flags)) + select(0u, 2u, all(flags));
            flags = resources.source[index] > float4(1.0);
            value = value + select(0u, 4u, any(flags)) + select(0u, 8u, all(flags));
            resources.result[index] = value;
        }
    }
}
